{
  "name": "codecrafthub",
  "version": "1.0.0",
  "description": "Full-stack personal learning goal tracker",
  "main": "app.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch app.js",
    "dev:web": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "prestart": "npm run build",
    "start": "node app.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^7.1.7"
  }
}
